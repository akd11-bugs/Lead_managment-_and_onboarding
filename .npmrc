# The @neondatabase/auth beta pulls @better-auth/api-key, which pins
# better-call to an exact version that conflicts with the one better-auth
# itself resolves. npm's v11 resolver crashes on that cycle outright
# ("Cannot read properties of null (reading 'edgesOut')") rather than
# reporting a peer conflict, so a clean install fails with no usable error.
#
# legacy-peer-deps makes npm resolve peers the pre-v7 way, which sidesteps
# the cycle. This file exists so CI and Render get the same behaviour as a
# local install without anyone needing to remember a flag.
#
# Revisit when @neondatabase/auth leaves beta.
legacy-peer-deps=true
