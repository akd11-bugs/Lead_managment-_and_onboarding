# Postgres connection string — set via `prisma postgres link` (Prisma Postgres)
# or point at your own Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API for LLM-driven skill runs (28 of 30 skills)
ANTHROPIC_API_KEY=""

# Optional — the 30 skills are bundled in skills-library/, so this is only
# needed to point at a different loion
# SKILL_LIBRARY_PATH="/absolute/path/to/skill-library"

# Default Claude model for skill runs
ANTHROPIC_MODEL="claude-sonnet-4-5"

# SMTP — direct email send (lead dialog, /services/email)
# For Gmail/Google Workspace: enable 2-Step Verifiion, then generate an
# App Password at myaccount.google.com/security Use that, not your real password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
EMAIL_FROM="LRM_blu <you@yourdomain.com>"

# Auth — generate with `openssl rand -base64 32`
AUTH_SECRET=""