# Postgres connection string — set via `prisma postgres link` (Prisma Postgres)
# or point at your own Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API for LLM-driven skill runs (28 of 30 skills)
ANTHROPIC_API_KEY=""

# Optional — the 30 skills are bundled in skills-library/, so this is only
# needed to point at a different loion
# SKILL_LIBRARY_PATH="/absolute/path/to/skill-library"

# Default Claude model for skill runs
ANTHROPIC_MODEL="claude-sonnet-4-5"

# SMTP — direct email send (lead dialog, /services/email)
# For Gmail/Google Workspace: enable 2-Step Verifiion, then generate an
# App Password at myaccount.google.com/security Use that, not your real password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
EMAIL_FROM="LRM_blu <you@yourdomain.com>"

# Auth — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Optional — Google sign-in alongside email+password. Create an OAuth Client
# ID (Web application) in Google Cloud Console, with an Authorized redirect
# URI of `<your-deployed-url>/api/auth/callback/google` (and
# `http://localhost:3000/api/auth/callback/google` for local dev). Leave both
# blank to disable Google sign-in entirely — the login page hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — enables GET /api/external/reports for an external admin
# dashboard to pull the same numbers as /reports. Cross-domain, server-to-
# server: callers authenticate with `Authorization: Bearer <this value>`
# instead of a login session. Leave blank to disable the endpoint (it
# returns 503). Generate with `openssl rand -base64 32`.
REPORTS_API_KEY=""

# Required to let a user configure their own outbound-email app password
# (Settings → Email) and to power workflow-rule email actions — secrets are
# encrypted at rest (AES-256-GCM) with this key before being stored.
# Generate with `openssl rand -base64 32`. Rotating it invalidates every
# already-saved personal email credential (users would need to re-enter them).
CREDENTIAL_ENCRYPTION_KEY=""

# Automated lead intake from a Google Sheet — POST /api/cron/sync-leads-sheet
# is meant to be hit periodically by an external scheduler (see
# .github/workflows/sync-leads-sheet.yml), authenticated the same way as
# REPORTS_API_KEY above. Leave CRON_SYNC_API_KEY blank to disable the route
# (it returns 503). Generate with `openssl rand -base64 32`.
CRON_SYNC_API_KEY=""

# A Google Cloud service account with "Viewer" access on the target Sheet
# (Google Sheets API must be enabled on the GCP project). Share the sheet
# with GOOGLE_SERVICE_ACCOUNT_EMAIL the same way you'd invite a collaborator.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the multiline "private_key" field from
# the downloaded service-account JSON key — paste it with its literal `\n`
# sequences intact (do not convert them to real newlines).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# The Sheet to sync from, and the range within it (defaults to "Sheet1" —
# the whole first sheet — if left blank). Row 1 is treated as a header row;
# column names are auto-mapped the same fuzzy way the CSV import dialog maps
# them, so exact naming isn't required. An optional "Owner"/"Assigned to"
# column (matched by name/email against existing users) sets each lead's
# owner; unmatched or missing falls back to SHEET_IMPORT_DEFAULT_OWNER_EMAIL.
LEADS_SHEET_ID=""
LEADS_SHEET_RANGE=""
SHEET_IMPORT_DEFAULT_OWNER_EMAIL=""

# Daily rep-wise activity summary emailed to every active admin —
# POST /api/cron/daily-activity-report, meant to be hit once a day by an
# external scheduler (see .github/workflows/daily-activity-report.yml),
# authenticated the same way as CRON_SYNC_API_KEY above. Leave blank to
# disable the route (it returns 503). Generate with `openssl rand -base64 32`.
DAILY_REPORT_API_KEY=""