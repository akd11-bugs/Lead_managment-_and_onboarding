# Postgres connection string — set via `prisma postgres link` (Prisma Postgres)
# or point at your own Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API for LLM-driven skill runs (28 of 30 skills)
ANTHROPIC_API_KEY=""

# Optional — the 30 skills are bundled in skills-library/, so this is only
# needed to point at a different loion
# SKILL_LIBRARY_PATH="/absolute/path/to/skill-library"

# Default Claude model for skill runs
ANTHROPIC_MODEL="claude-sonnet-4-5"

# SMTP — direct email send (lead dialog, /services/email)
# For Gmail/Google Workspace: enable 2-Step Verifiion, then generate an
# App Password at myaccount.google.com/security Use that, not your real password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
EMAIL_FROM="LRM_blu <you@yourdomain.com>"

# Auth — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Optional — Google sign-in alongside email+password. Create an OAuth Client
# ID (Web application) in Google Cloud Console, with an Authorized redirect
# URI of `<your-deployed-url>/api/auth/callback/google` (and
# `http://localhost:3000/api/auth/callback/google` for local dev). Leave both
# blank to disable Google sign-in entirely — the login page hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — enables GET /api/external/reports for an external admin
# dashboard to pull the same numbers as /reports. Cross-domain, server-to-
# server: callers authenticate with `Authorization: Bearer <this value>`
# instead of a login session. Leave blank to disable the endpoint (it
# returns 503). Generate with `openssl rand -base64 32`.
REPORTS_API_KEY=""

# Required to let a user configure their own outbound-email app password
# (Settings → Email) and to power workflow-rule email actions — secrets are
# encrypted at rest (AES-256-GCM) with this key before being stored.
# Generate with `openssl rand -base64 32`. Rotating it invalidates every
# already-saved personal email credential (users would need to re-enter them).
CREDENTIAL_ENCRYPTION_KEY=""