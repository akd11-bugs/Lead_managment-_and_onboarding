// Prisma schema for LRM_blu
// Stage is a string (not enum) so the LMS can stay flexible if stages change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// An organization is one customer company — flat, isolated, no nesting.
// Every org-scoped model's `orgId` is the sole tenant boundary; there is no
// cross-org visibility by design (see lib/session.ts's visibleOrgIds).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Scopes an admin-generated key to this org alone for
  // app/api/external/reports — null until an admin generates one from
  // Settings. Plaintext + unique index, same convention as Invite.code and
  // SignupToken.token (a random 32-byte token has no meaningful brute-force
  // surface, so there's nothing a hash buys here that a unique index doesn't).
  reportsApiKey String? @unique

  emailConfig    OrgEmailConfig?
  sheetConnector OrgSheetConnector?
  companies      Company[]
  people         Person[]
}

// An org's own outbound mailbox — lets an org bring its own SMTP instead of
// the global env-configured shared mailbox (lib/email.ts's sendEmail()
// fallback) or a single user's personal Gmail (User.emailAppPasswordEnc).
// Precedence at send time: the sending user's personal Gmail config, then
// this org config, then the global env fallback — see lib/email.ts.
model OrgEmailConfig {
  id          String   @id @default(cuid())
  orgId       String   @unique
  org         Organization @relation(fields: [orgId], references: [id])
  smtpHost    String
  smtpPort    Int
  smtpSecure  Boolean  @default(true)
  smtpUser    String
  smtpPassEnc String   // AES-256-GCM ciphertext, same format as User.emailAppPasswordEnc
  fromAddress String
  fromName    String?
  configuredAt       DateTime @default(now())
  configuredByUserId String?
}

// An org's own Google Sheet lead source — lets an org configure its own
// sheet from Settings instead of the single global env-configured sheet
// (LEADS_SHEET_ID) that app/api/cron/sync-leads-sheet/route.ts used to be
// hardcoded to. That global sheet keeps syncing alongside any configured
// connectors here — this is additive, not a replacement, until it's
// explicitly removed.
//
// No per-org service account here on purpose: every org shares the one
// deployment-wide service account (GOOGLE_SERVICE_ACCOUNT_EMAIL/
// GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY in .env, see lib/googleSheets.ts). An
// org admin's whole setup is: share their sheet with that one email, then
// paste the sheet ID here — no GCP project or credentials of their own.
model OrgSheetConnector {
  id                 String    @id @default(cuid())
  orgId              String    @unique
  org                Organization @relation(fields: [orgId], references: [id])
  // Unique across ALL orgs, not just per-org — a sheet connected by one
  // org must not be claimable by a second org, which would let that org's
  // sync cron read a stranger's sheet (sheet IDs are often shared/pasted
  // into chat, not secret).
  sheetId            String    @unique
  sheetRange         String    @default("Sheet1")
  defaultOwnerUserId String
  enabled            Boolean   @default(true)
  lastSyncedAt       DateTime?
  configuredAt         DateTime  @default(now())
  configuredByUserId   String?
}

// Per-org pipeline stage configuration. `key` is what Lead.stage actually
// stores — the 5 built-in stages (isCore: true) keep a locked key/position
// because business logic in lib/leadStage.ts, lib/alerts.ts, and
// lib/reportsData.ts branches on those literal string values; only their
// label/description/color are admin-editable. Custom (isCore: false) stages
// are purely decorative extra Kanban columns with no attached automation.
model StageDefinition {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  label       String
  description String?
  color       String?
  position    Int
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([orgId, key])
  @@index([orgId, position])
}

// Per-org onboarding sub-pipeline configuration. Lead.onboardingSubStage
// stores `key` directly. Whichever row is `isCore: true` represents the
// final/complete step — its key is what lib/leadStage.ts checks to set
// onboardedAt, and lib/reportsData.ts depends on the Activity description
// convention `(<key>)` for that same row. Only that row's key/position are
// locked; intermediate steps are fully admin add/remove/reorder/rename-able.
model OnboardingStepDefinition {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  label     String
  position  Int
  isCore    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([orgId, key])
  @@index([orgId, position])
}

// Per-org custom fields on a Lead. `key` is immutable after creation —
// stored values in Lead.customFieldsJson are keyed by it, so renaming would
// orphan data (label is the editable, user-facing name instead).
model LeadFieldDefinition {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  label     String
  type      String   // "text" | "number" | "date" | "select"
  options   String?  // JSON-stringified string array — only meaningful when type = "select"
  required  Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  @@unique([orgId, key])
  @@index([orgId, position])
}

// A company is shared across every Lead/Person that belongs to it — normal
// for many contacts/deals to share one Company, so there is deliberately no
// per-Lead duplicate string anymore (see Person/Lead below).
model Company {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  name           String
  // lowercase + trimmed + collapsed whitespace — the actual dedup key.
  // Enforced as a real DB constraint (@@unique) instead of the old
  // application-level findFirst check, which could race under concurrent
  // writes (two simultaneous imports both "finding no match" and creating
  // two rows for the same company).
  normalizedName String
  website        String?
  industry       String?  // the company's own profile value — independent of any one Lead's industry/businessType, which stay per-deal on Lead itself (a company's profile and one specific deal's details are different things, not a duplicate of the same fact)
  businessType   String?  // b2b | b2c — company profile default, same independence as industry above
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  people         Person[]
  leads          Lead[]

  @@unique([orgId, normalizedName])
  @@index([orgId, name])
}

// A point of contact at a Company. Optional on Lead — not every lead has an
// identified contact yet — but when set, always belongs to that lead's
// Company (enforced in application code at the two write sites, not the DB,
// since Prisma has no cross-field constraint).
model Person {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]

  @@index([orgId, companyId])
  @@index([orgId, name])
}

model Lead {
  id              String       @id @default(cuid())
  orgId           String
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  personId        String?
  person          Person?      @relation(fields: [personId], references: [id])
  email           String
  phone           String?
  website         String?
  industry        String?      // free text vertical, e.g. "Fashion", "Apparel" — filled by sales
  businessType    String?      // b2b | b2c
  source          String       // website | referral | linkedin | cold_outreach | event | other
  stage           String       // new | pending | proposal | onboarding | not_interested
  estimatedVolume Float        @default(0)
  ownerId         String       @default("self")
  ownerName       String       @default("You")
  effort          String       @default("medium") // low | medium | high
  quality         String       @default("medium") // low | medium | high
  type            String       @default("merchant") // partner | merchant — a partner brings multiple merchants (e.g. Shopify)
  wonAt           DateTime?    // set automatically the moment stage enters "onboarding" — sales-side won, distinct from onboardedAt
  onboardedAt     DateTime?    // set automatically once onboardingSubStage reaches "final_onboarded"
  expectedCloseDate DateTime?  // forecast date for BD reporting (leads not yet onboarded)
  proposalSubStage String?     // retired with the old proposal stage — column kept (unused) so historical data isn't dropped
  pendingSubStatus String?     // pending_ours | pending_merchant | pending_psp — only meaningful when stage == "pending"
  onboardingSubStage String?   // document_submission | document_verification | psp_verification | final_onboarded — only meaningful when stage == "onboarding"
  assignedOpsId    String?     // operations User.id handling this lead's onboarding — set the moment stage enters "onboarding", cleared on leaving
  assignedOpsName  String?     // denormalized, same convention as ownerName
  painPoints      String       @default("") // discovery: what's hurting them today
  whatTheyWant    String       @default("") // discovery: what they're actually asking for
  notes           String       @default("")
  customFieldsJson String      @default("{}") // JSON.stringify(Record<LeadFieldDefinition.key, value>) — same serialized-JSON-in-a-String convention as WorkflowRule.triggerConfig
  position        Int          @default(0)  // ordering within a kanban column
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastActivityAt  DateTime?
  activities      Activity[]
  skillRuns       SkillRun[]
  tasks           Task[]

  @@index([orgId])
  @@index([stage, position])
  @@index([ownerId])
  @@index([source])
  @@index([lastActivityAt])
  @@index([quality])
  @@index([type])
  @@index([onboardedAt])
  @@index([wonAt])
  @@index([expectedCloseDate])
}

model User {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  email               String    @unique
  passwordHash        String?   // null for Google-only accounts — no password was ever set
  role                String    @default("sales") // admin | sales | operations | pending
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  // Personal outbound email — lets a rep send automated/triggered mail from
  // their own address instead of the shared app mailbox. Write-only from the
  // API's perspective: emailAppPasswordEnc is never returned to the client.
  emailFromAddress    String?
  emailAppPasswordEnc String?   // AES-256-GCM ciphertext: "iv:authTag:ciphertext", base64
  emailConfiguredAt   DateTime?

  // Rep-form auth (/rep) — separate identity from the real password above, so
  // a lockout on one never locks the other. Only set once an admin issues a PIN.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  // No hard FK from Lead.ownerId — kept a plain string (like stage/source) so
  // imported/legacy leads with an unrecognized owner never fail to save.

  @@index([orgId])
}

model WorkflowRule {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  triggerType   String   // "stage_changed"
  triggerConfig String   // JSON.stringify, e.g. {"toStage":"won"}
  actionType    String   // "create_task" | "send_email"
  actionConfig  String   // JSON.stringify, e.g. {"title":"...","dueInDays":2}
  ownerId       String   // plain string, same convention as Task.ownerId — no hard FK to User
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([orgId, ownerId, triggerType, active])
}

model SavedView {
  id          String   @id @default(cuid())
  orgId       String
  userId      String   // plain string, same convention as Task.ownerId — no hard FK to User
  name        String
  // "leads" | "companies" — one model serves both table types rather than a
  // parallel CompanySavedView; the stored shape differs (see filtersJson)
  // but the CRUD/ownership semantics are identical.
  viewType    String   @default("leads")
  filtersJson String   // JSON.stringify of the table's filter/sort/column state — shape depends on viewType
  createdAt   DateTime @default(now())

  @@index([orgId, userId])
  @@index([orgId, userId, viewType])
}

model Task {
  id        String    @id @default(cuid())
  orgId     String
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  source    String    @default("manual") // manual | alert | sequence
  ownerId   String?   // scopes visibility for the Sales role, same convention as Lead.ownerId
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([done, dueDate])
  @@index([orgId, ownerId])
}

model Activity {
  id          String   @id @default(cuid())
  orgId       String
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   // call | email | meeting | note | onboarding_step | stage_change
  description String
  authorName  String   @default("You")
  date        DateTime @default(now())

  @@index([leadId, date])
  @@index([orgId, date])
}

model Invite {
  id               String    @id @default(cuid())
  orgId            String
  name             String?   // optional for a reusable link — it isn't naming one person in advance
  role             String    // admin | sales | operations
  code             String    @unique
  status           String    @default("pending") // pending | redeemed | revoked
  // When true, redemption never flips status to "redeemed" — the same link
  // stays usable by any number of different people until an admin revokes
  // it, instead of being one-code-per-person like a regular invite.
  isReusable       Boolean   @default(false)
  createdById      String
  createdAt        DateTime  @default(now())
  redeemedAt       DateTime?
  redeemedByUserId String?

  @@index([orgId, status])
}

// Tracks a request to join an existing org — created when someone signs in
// with an email whose domain matches an org that already exists (see
// app/account-not-found/page.tsx), not by an admin inviting a known person
// (that's what Invite is for). Approving one just creates a real Invite
// (role: 'sales') and emails the requester a redeem link — this model only
// ever tracks the request itself, never the account creation.
model JoinRequest {
  id              String   @id @default(cuid())
  orgId           String
  requesterName   String
  requesterEmail  String
  status          String   @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now())

  @@index([orgId, status])
}

model SignupToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Note: SignupToken deliberately has no orgId — Phase 2's "create your
// organization" flow issues the org only once the token is completed
// (there is no org yet at request time).

model AuditLog {
  id             String   @id @default(cuid())
  orgId          String?  // null for pre-signup events with no org yet (e.g. login_failed on an unknown email)
  action         String   // login_success | login_failed | login_locked | invite_created | invite_redeemed | invite_revoked | user_role_changed | user_deactivated | user_activated | user_deleted
  actorUserId    String?  // null for anonymous/failed-login events
  targetUserId   String?
  targetInviteId String?
  metadata       String?  // JSON-serialized string, same convention as SkillRun.inputJson
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([orgId, createdAt])
}

// Small general-purpose key-value cursor store — currently just tracks how
// many rows of the leads Google Sheet have already been synced, so the cron
// route doesn't re-scan/re-dedupe the whole sheet on every run.
model SyncCursor {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// One row per cron-route invocation, written at the end of the handler —
// backs the operations dashboard's "last run" health view without depending
// on GitHub Actions API access (not reliably available to the app itself).
model JobRun {
  id         String    @id @default(cuid())
  orgId      String?   // null for jobs that aren't org-scoped (e.g. today's single global sheet sync)
  jobKey     String    // e.g. "sync-leads-sheet" | "daily-activity-report"
  status     String    // "success" | "failure"
  startedAt  DateTime
  finishedAt DateTime
  error      String?

  @@index([jobKey, finishedAt])
  @@index([orgId, finishedAt])
}

model SkillRun {
  id               String   @id @default(cuid())
  orgId            String
  skillId          String   // e.g. 'pipeline-hygiene-audit'
  skillName        String   // display name
  scope            String   // 'portfolio' | 'lead:<id>'
  runnerType       String   // 'script' | 'llm'
  inputJson        String   // serialized snapshot sent to the skill
  outputMarkdown   String   // raw markdown output
  outputStructured String?  // serialized JSON for rendering (optional)
  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([skillId])
  @@index([leadId])
  @@index([createdAt])
  @@index([orgId, createdAt])
}

// One org-wide whiteboard — every admin/sales/ops user in the org sees and
// edits the same canvas, the same flat-tenant convention every other model
// here uses. No live multiplayer sync (no websocket infra in this app):
// each save persists here and another open tab sees it on its next load,
// not instantly — the UI says so rather than implying real-time it doesn't
// have. type/x/y/w/h/color/text cover sticky notes and shapes directly;
// dataJson carries the few fields that don't apply to every type (a
// stamp's emoji, an arrow's x2/y2, a funnel box's stage key, a freehand
// path's point list) rather than adding a column nothing else uses.
model WhiteboardElement {
  id        String   @id @default(cuid())
  orgId     String
  type      String   // 'sticky' | 'rect' | 'circle' | 'arrow' | 'freepath' | 'stamp' | 'funnel'
  x         Float
  y         Float
  w         Float?
  h         Float?
  color     String?
  text      String?
  dataJson  String   @default("{}")
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}
