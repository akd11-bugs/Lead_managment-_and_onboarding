# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/dev.db
/prisma/dev.db-journal
/prisma/migrations/dev/
/prisma/prisma/

# python (skill scripts)
/__pycache__/
*.pyc

# misc
.idea/
.vscode/

# Local scratch work — verification scripts, debug dumps, screenshots.
# Untracked but previously unignored, so easy to commit by accident.
scratchpad/

# Generated launch-video output (/brag) — large MP4s and render intermediates.
brag-output/
brag-output-*/

# Per-machine MCP server config; may reference local endpoints or keys.
.mcp.json

# Claude Code / agent tooling — skills, plugins, design-system scaffolding.
# Per-developer-machine setup, not part of the shipped product; keeping it
# out of the repo means a stray `git add -A`/`git add .` can't pull in a
# third-party skill's full source (e.g. a downloaded design/taste skill)
# alongside real app code.
.agents/
.claude/agents/
.claude/skills/
.claude/settings.json
.github/agents/
.github/skills/
.github/hooks/
.impeccable/
DESIGN.md
PRODUCT.md
skills-lock.json


